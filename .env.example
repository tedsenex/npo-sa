# 複製成 .env.local 後填值。
# 變數集中在 src/lib/env.ts 以 Zod 驗證，缺變數就啟動失敗。

# Supabase — NEXT_PUBLIC_ 開頭的兩個會進 client bundle，只放 anon key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service role 會繞過 RLS，只准在 migration 與後台工作使用，絕不可進 client
SUPABASE_SERVICE_ROLE_KEY=

# 只在 server 端使用。任何 "use client" 檔案碰到 Anthropic SDK 就是嚴重錯誤
ANTHROPIC_API_KEY=

# 週報、邀請信
RESEND_API_KEY=
